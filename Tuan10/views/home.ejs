<h1>Product List</h1>

<a href="/add">Add Product</a>

<table border="1">

<tr>
<th>No</th>
<th>Name</th>
<th>Image</th>
<th>Price</th>
<th>Quantity</th>
<th>Action</th>
</tr>

<% products.forEach((p,index) => { %>

<tr>

<td><%= index + 1 %></td>

<td><%= p.name %></td>

<td>

<% if (p.image) { %>

<img src="<%= p.image %>" width="100">

<% } else { %>

No Image

<% } %>

</td>

<td><%= p.price %></td>

<td><%= p.quantity %></td>

<td>

<a href="/edit/<%= p.id %>">Edit</a>

<a href="/delete/<%= p.id %>" onclick="return confirm('Delete this product?')">
Delete
</a>

</td>

</tr>

<% }) %>

</table>