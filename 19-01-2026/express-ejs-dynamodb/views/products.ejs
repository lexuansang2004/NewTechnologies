<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Product Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

    <div class="max-w-4xl mx-auto py-10">

        <h1 class="text-3xl font-bold text-center mb-8 text-blue-600">
            Product Management (DynamoDB)
        </h1>

        <!-- Add product -->
        <div class="bg-white p-6 rounded-xl shadow mb-8">
            <h2 class="text-xl font-semibold mb-4">Add Product</h2>

            <form action="/add" method="post" class="grid grid-cols-3 gap-4">
                <input name="name" placeholder="Product name" class="border p-2 rounded col-span-1" required>

                <input name="price" placeholder="Price" class="border p-2 rounded col-span-1" required>

                <input name="quantity" placeholder="Quantity" class="border p-2 rounded col-span-1" required>

                <button class="col-span-3 bg-blue-600 text-white py-2 rounded hover:bg-blue-700">
        Add Product
      </button>
            </form>
        </div>

        <!-- Product list -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h2 class="text-xl font-semibold mb-4">Product List</h2>

            <table class="w-full border">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="p-2 border">Name</th>
                        <th class="p-2 border">Price</th>
                        <th class="p-2 border">Quantity</th>
                        <th class="p-2 border">Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% products.forEach(p => { %>
                        <tr class="text-center hover:bg-gray-50">
                            <td class="p-2 border">
                                <%= p.name %>
                            </td>
                            <td class="p-2 border">
                                <%= p.price %>
                            </td>
                            <td class="p-2 border">
                                <%= p.quantity %>
                            </td>
                            <td class="p-2 border space-x-2">
                                <a href="/edit/<%= p.id %>" class="px-3 py-1 bg-yellow-400 text-white rounded hover:bg-yellow-500">
              Edit
            </a>

                                <form action="/delete/<%= p.id %>" method="post" class="inline">
                                    <button class="px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600">
                Delete
              </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>

    </div>
</body>

</html>