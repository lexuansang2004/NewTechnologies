<h2 class="text-3xl text-[#66FCF1] mb-6 font-bold">
    Product List
</h2>

<div class="flex justify-between mb-6">

    <input id="searchInput" type="text" placeholder="Search product..." class="bg-[#1F2833] border border-[#45A29E] p-3 rounded w-80">

    <a href="/add" class="bg-[#66FCF1] text-black px-5 py-2 rounded hover:bg-[#45A29E] accent">
Add Product
</a>

</div>

<div class="card bg-[#1F2833] rounded-lg shadow-lg overflow-hidden">

    <table class="w-full text-center table-auto">

        <thead class="border-b border-[#45A29E]">
            <tr>

                <th class="p-4">Image</th>
                <th class="p-4">Name</th>
                <th class="p-4">Price</th>
                <th class="p-4">Stock</th>
                <th class="p-4">Action</th>

            </tr>
        </thead>

        <tbody id="productTable">

            <% products.forEach(p => { %>

                <tr class="border-b border-[#0B0C10] hover:bg-[#0B0C10] transition">

                    <td class="p-4">
                        <div class="w-20 h-20 mx-auto flex items-center justify-center bg-[#0B0C10] rounded">
                            <img src="<%= p.url_image %>" class="max-h-full max-w-full object-contain" />
                        </div>
                    </td>

                    <td class="p-4 text-[#66FCF1] font-semibold">
                        <%= p.name %>
                    </td>

                    <td class="p-4">
                        $
                        <%= p.price %>
                    </td>

                    <td class="p-4">
                        <span class="bg-[#45A29E] px-3 py-1 rounded">
        <%= p.unit_in_stock %>
        </span>
                    </td>

                    <td class="p-4 space-x-2">

                        <a href="/detail/<%= p.id %>" class="bg-[#45A29E] px-3 py-1 rounded">
        View
        </a>

                        <a href="/edit/<%= p.id %>" class="bg-yellow-500 text-black px-3 py-1 rounded">
        Edit
        </a>

                        <button onclick="confirmDelete('<%= p.id %>')" class="bg-red-500 px-3 py-1 rounded">
        Delete
        </button>

                    </td>

                </tr>

                <% }) %>

        </tbody>
    </table>

</div>