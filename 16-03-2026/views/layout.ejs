<!DOCTYPE html>
<html>

<head>

    <title>Product Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* LIGHT MODE */
        
        body.light {
            background: #EDC7B7;
            color: #123C69;
        }
        
        body.light nav {
            background: #EEE2DC;
            color: #123C69;
        }
        
        body.light .card {
            background: #EEE2DC;
        }
        
        body.light table {
            background: #EEE2DC;
        }
        
        body.light th {
            color: #123C69;
        }
        
        body.light td {
            color: #123C69;
        }
        
        body.light input {
            background: #EEE2DC;
            border: 1px solid #BAB2B5;
            color: #123C69;
        }
        
        body.light .accent {
            background: #AC3B61;
            color: white;
        }
    </style>

</head>

<body id="body" class="bg-[#0B0C10] text-[#C5C6C7] transition">

    <nav class="bg-[#1F2833] p-4">

        <div class="max-w-6xl mx-auto flex items-center gap-6">

            <a href="/" class="hover:text-[#66FCF1] font-semibold">
Home
</a>

            <button onclick="toggleTheme()" class="ml-auto border border-[#45A29E] px-4 py-1 rounded hover:bg-[#45A29E]">
🌙 ☀
</button>

        </div>

    </nav>


    <div class="max-w-6xl mx-auto p-6">

        <%- body %>

    </div>


    <div id="toast" class="fixed top-6 right-6 bg-[#45A29E] text-black px-6 py-3 rounded shadow-lg hidden">
        Success
    </div>


    <script src="/js/main.js"></script>

</body>

</html>